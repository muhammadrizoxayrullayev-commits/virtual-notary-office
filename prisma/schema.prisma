datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DIRECTOR
  EMPLOYEE
  CLIENT
}

enum EmployeeStatus {
  ONLINE
  BUSY
  IN_LUNCH
  OFFLINE
}

enum DocumentStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CLIENT)
  status        EmployeeStatus @default(OFFLINE)
  
  lastActive    DateTime  @default(now())
  
  accounts      Account[]
  sessions      Session[]
  documents     Document[] @relation("ClientDocuments")
  reviewedDocs  Document[] @relation("ReviewerDocuments")
  presenceLogs  PresenceLog[]
  queueTicket   QueueTicket?
}

model PresenceLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    EmployeeStatus
  timestamp DateTime @default(now())
}

model Document {
  id          String   @id @default(cuid())
  title       String
  contentUrl  String
  status      DocumentStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientId    String
  client      User     @relation("ClientDocuments", fields: [clientId], references: [id], onDelete: Cascade)
  
  reviewerId  String?
  reviewer    User?    @relation("ReviewerDocuments", fields: [reviewerId], references: [id])
}

model QueueTicket {
  id          Int      @id @default(autoincrement())
  status      String   
  createdAt   DateTime @default(now())
  
  clientId    String   @unique
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
